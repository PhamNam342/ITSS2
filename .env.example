# Copy thành .env rồi điền. Tạo chuỗi ngẫu nhiên: openssl rand -hex 32
# .env KHÔNG được commit (đã có trong .gitignore).

# Postgres
POSTGRES_PASSWORD=          # superuser 'postgres', chỉ dùng trong container db và backup
APP_DB_PASSWORD=            # role antam_app mà api dùng. Chỉ gồm chữ + số (nằm trong URL kết nối)

# App
NODE_ENV=production         # development: bật CORS cho localhost, cookie không Secure
APP_ENV=demo                # demo | prod  (prod: tắt hẳn /api/demo/*)
PUBLIC_URL=https://<domain>
ACCOUNT_HASH_SECRET=        # HMAC số tài khoản. Đổi giá trị này = phải liên kết lại tài khoản

# Ngân hàng (spec 8). SePay không cần biến nào: mỗi người dùng tự lấy URL + API key trong app.
# Email biên lai Vietcombank: Cloudflare Email Worker gửi về /api/webhooks/email. Để trống = tắt.
EMAIL_WEBHOOK_SECRET=       # openssl rand -hex 32; đặt cùng giá trị vào secret của Worker
MAIL_DOMAIN=                # tên miền gốc bật Email Routing, ví dụ <apex-domain>. Địa chỉ cấp cho user: <token>@MAIL_DOMAIN
